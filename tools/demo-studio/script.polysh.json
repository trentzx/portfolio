{
  "title": "polysh",
  "tagline": "one shell, every dialect",
  "subtitle": "type Linux commands in PowerShell. they just run.",
  "accent": "#5eb1ff",
  "accent2": "#7ee787",
  "backdrop": [
    "#0d1a2b",
    "#2f7fd0",
    "#2fa36a",
    "#6b4bc4"
  ],
  "cwd": "~/projects/polysh",
  "steps": [
    {
      "prompt": "PS>",
      "cmd": "grep -i error app.log",
      "hint": null,
      "err": true,
      "out": [
        "The term 'grep' is not recognized as the name of a cmdlet,",
        "function, script file, or operable program."
      ],
      "zoom": false,
      "pause": 1.2
    },
    {
      "prompt": "PS>",
      "cmd": "polysh init powershell >> $PROFILE",
      "hint": null,
      "out": [],
      "zoom": false,
      "pause": 0.9
    },
    {
      "prompt": "PS>",
      "cmd": "grep -i error app.log",
      "hint": "→ Select-String -Pattern 'error' -Path app.log   (POSIX sh → PowerShell)",
      "out": [
        "app.log:2:2026-11-17 10:03 ERROR db timeout",
        "app.log:4:2026-11-17 10:05 ERROR db timeout"
      ],
      "zoom": true,
      "pause": 1.2
    },
    {
      "prompt": "PS>",
      "cmd": "Get-Content app.log | grep -i error | head -2",
      "hint": [
        "→ Select-String -Pattern 'error'   (POSIX sh → PowerShell)",
        "→ Select-Object -First 2   (POSIX sh → PowerShell)"
      ],
      "out": [
        "2026-11-17 10:03 ERROR db timeout",
        "2026-11-17 10:05 ERROR db timeout"
      ],
      "zoom": true,
      "pause": 1.3
    },
    {
      "prompt": "PS>",
      "cmd": "polysh",
      "hint": null,
      "out": [
        "polysh 0.3.0 · Windows cmd · type 'help' for help"
      ],
      "zoom": false,
      "pause": 0.5
    },
    {
      "prompt": "›",
      "cmd": "ls",
      "hint": "→ dir /B   (POSIX sh → Windows cmd)",
      "out": [
        "app.log",
        "README.md",
        "src"
      ],
      "zoom": false,
      "pause": 1.5
    }
  ],
  "bitrate": 2200000
}
